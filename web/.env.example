# Copier ce fichier en .env.local pour le développement.
# En production, renseigner ces variables dans Render (Environment).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ASSO_NAME="3 As de Cœur"

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : JAMAIS côté client, JAMAIS dans git.
SUPABASE_SERVICE_ROLE_KEY=

# --- HelloAsso (https://admin.helloasso.com > Mon compte > Intégrations et API) ---
HELLOASSO_ORG_SLUG=
# URL du formulaire de don (le site ajoute /widget pour l'intégration)
NEXT_PUBLIC_HELLOASSO_DONATION_URL=https://www.helloasso.com/associations/<slug>/formulaires/1
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Jeton aléatoire ajouté à l'URL de notification : /api/helloasso/webhook?token=...
HELLOASSO_WEBHOOK_TOKEN=

# --- Mode démo (développement uniquement) ---
# DEMO_MODE=true remplace Supabase par une base fictive locale. NE JAMAIS l'activer en production.
DEMO_MODE=false
DEMO_SESSION_SECRET=
DEMO_ADMIN_EMAIL=admin@demo.test
DEMO_ADMIN_PASSWORD=
DEMO_COORDINATOR_EMAIL=coordination@demo.test
DEMO_COORDINATOR_PASSWORD=
DEMO_VOLUNTEER_EMAIL=benevole@demo.test
DEMO_VOLUNTEER_PASSWORD=
